{
  "name": "prior-auth-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "bun run dev:client & bun run dev:server",
    "dev:client": "bun run --cwd client dev",
    "dev:server": "bun run --cwd server dev",
    "build": "bun run build:client",
    "build:client": "bun run --cwd client build",
    "start": "bun run --cwd server start",
    "start:server": "bun run --cwd server start",
    "typecheck": "bun run typecheck:client && bun run typecheck:server",
    "typecheck:client": "bun run --cwd client typecheck",
    "typecheck:server": "bun run --cwd server typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
